{
  "manifest_version": 3,
  "name": "Docs Comment Warning Helper",
  "version": "1.0.0",
  "description": "Hides comment rate warnings in Google Docs, Slides, and Sheets with a reminder to verify your comment.",
  "content_scripts": [
    {
      "matches": [
        "https://docs.google.com/document/*",
        "https://docs.google.com/presentation/*",
        "https://docs.google.com/spreadsheets/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
